# Copy to .env and fill in. Never commit .env.

# Option A: one URL (recommended)
DATABASE_URL=postgresql+psycopg2://postgres@localhost:5432/postgres

# Option B: separate values (leave disabled when using DATABASE_URL)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=

LOG_LEVEL=INFO
MAX_UPLOAD_MB=20
UPSERT_BATCH_SIZE=5000
